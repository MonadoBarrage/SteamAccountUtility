<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:SteamAccountUtility.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="SteamAccountUtility.Views.AuxiliaryGameView"
  x:DataType="vm:AuxiliaryGameViewModel"
  Width="200"
>
  <StackPanel Spacing="5">
    <Button>
      <Panel>
        <Image
          IsVisible="{Binding Game.LibraryImage, 
                    Converter={x:Static ObjectConverters.IsNull}}"
          Source="avares://SteamAccountUtility/Assets/CapsuleImageNotFound.png"
        />
        <Image Stretch="Uniform" Source="{Binding Game.LibraryImage}" />
      </Panel>
    </Button>
  </StackPanel>
</UserControl>
