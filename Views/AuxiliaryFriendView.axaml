<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:SteamAccountUtility.ViewModels"
  mc:Ignorable="d"
  d:DesignWidth="800"
  d:DesignHeight="450"
  x:Class="SteamAccountUtility.Views.AuxiliaryFriendView"
  x:DataType="vm:AuxiliaryFriendViewModel"
  Width="200"
>
  <StackPanel Spacing="5">
    <!-- <Border CornerRadius="10"> -->
    <StackPanel>
      <Image
        IsVisible="{Binding Friend.AvatarIcon, 
            Converter={x:Static ObjectConverters.IsNull}}"
        Source="avares://SteamAccountUtility/Assets/IconImageNotFound.png"
      />
      <TextBlock
        IsVisible="{Binding Friend.ProfileName, 
            Converter={x:Static ObjectConverters.IsNull}}"
        Text="Username not Found"
        HorizontalAlignment="Center"
      />

      <Image Stretch="Uniform" Source="{Binding Friend.AvatarIcon}" />
      <TextBlock Text="{Binding Friend.ProfileName}" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- </Border> -->
  </StackPanel>
</UserControl>
