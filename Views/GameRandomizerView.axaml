<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="using:SteamAccountUtility.Views"
        xmlns:vm="using:SteamAccountUtility.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SteamAccountUtility.Views.GameRandomizerView"
        x:DataType="vm:GameRandomizerViewModel">
    <StackPanel>
        
        <v:AuxiliaryGameView DataContext="{Binding SelectedGame }" />
        <Button IsEnabled="{Binding EnableButton}" 
                Command="{Binding StopAndSelectGameCommand}" 
                HorizontalAlignment="Center">
            Randomize a game
        </Button>
    </StackPanel>
</UserControl>
