<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SteamAccountUtility.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SteamAccountUtility.Views.AuxiliaryGameView"
             x:DataType="vm:AuxiliaryGameViewModel"
             Width="200">
    <UserControl.Resources>
        <DrawingImage x:Key="CoverFallback">
            <DrawingImage.Drawing>
                <DrawingGroup >
                    <GeometryDrawing>
                        <RectangleGeometry  Rect="-2 -2 28 28" />
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White"
                                     Geometry="{DynamicResource game_icon}" 
                                     />
                </DrawingGroup>

            </DrawingImage.Drawing>
        </DrawingImage>
    </UserControl.Resources>
    
    <!-- <Button Command="{Binding YayCommand}"> -->
        <StackPanel Spacing="5" Width="200">
            <Border CornerRadius="10" ClipToBounds="True" Background="#7FFF22DD">
                <Button >
                <Image Width="200" Height="200"
                       Stretch="Uniform"
                       Source="{Binding Game.LibraryImage}"
                       />
                <!-- Source="{StaticResource CoverFallback}"  -->
                </Button>
            </Border>
            <TextBlock TextWrapping="Wrap" Text="{Binding Game.Name} "/>
        </StackPanel>
    <!-- </Button> -->
</UserControl>